{
  "appId": "com.moonvisionmedia.shutterblip",
  "appName": "ShutterBlip",
  "webDir": "www",
  "backgroundColor": "#0C0C0D",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0C0C0D"
  },
  "android": {
    "backgroundColor": "#0C0C0D"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#0C0C0D",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0C0C0D",
      "overlaysWebView": true
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    }
  }
}