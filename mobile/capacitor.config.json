{
  "appId": "com.moonvisionmedia.shutterblip",
  "appName": "ShutterBlip",
  "webDir": "www",
  "backgroundColor": "#0E1117",
  "ios": { "contentInset": "never", "backgroundColor": "#0E1117" },
  "android": { "backgroundColor": "#0E1117" },
  "plugins": {
